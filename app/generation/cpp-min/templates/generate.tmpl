template <typename L, typename M>
struct MP_findImpl;
template <template <typename...> typename L, typename... T, typename M>
struct MP_findImpl<L<T...>, M> {
    using type = MP_size_t<[]() -> std::size_t {
        constexpr auto match = std::array{M::template fn<T>::value...};
        std::size_t index = 0;
        for (; index < sizeof...(T); ++index) {
            if (match[index]) {
                break;
            }
        }
        return index;
    }()>;
};
template <typename L, typename M>
