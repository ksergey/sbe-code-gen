    {% for field in group.fields | selectattr('token', 'in', ['group', 'data']) %}
    // {{ field.name }} ({{ field.token }})
        {% if field.token == 'group' %}
            {% if field.fields | selectattr('token', 'in', ['group', 'data' ]) | list | length > 0 %}
    result += {{ field.dimension_type.encoded_length }};
    for (auto const& entry : field_{{ field.name }}) {
