// compile time string
template <std::size_t N>
struct CtStr {
    char data[N];

    consteval CtStr(char const* str) noexcept {
        std::copy_n(str, N, data);
    }

    [[nodiscard]] constexpr operator std::string_view() const noexcept {
        return std::string_view{data, N - 1};
    }
};
template <std::size_t N>
