class CodecContext:
    """A cursor over a growable buffer. `reserve()` extends the buffer with
    zero bytes on demand, so encoding never requires guessing a buffer size
    up front - callers never pre-allocate."""

    __slots__ = ('buffer', 'offset')

    def __init__(self, buffer: Optional[bytearray] = None, offset: int = 0) -> None:
        self.buffer = buffer if buffer is not None else bytearray()
        self.offset = offset

    def reserve(self, size: int) -> None:
        end = self.offset + size
        if len(self.buffer) < end:
            self.buffer.extend(bytes(end - len(self.buffer)))


