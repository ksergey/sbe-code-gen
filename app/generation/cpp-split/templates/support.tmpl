// Reads/writes a trivially-copyable scalar at `ptr`, which may not satisfy alignof(T)
// (SBE field offsets are packed and are not guaranteed to be aligned). A direct
// `*std::bit_cast<T*>(ptr)` dereference of an unaligned pointer is undefined behaviour;
// memcpy is the standard-sanctioned way to do this regardless of alignment, and compilers
// turn it back into a plain unaligned load/store when they can.
template <typename T>
[[nodiscard]] inline auto loadUnaligned(std::byte const* ptr) noexcept -> T {
    T value;
    std::memcpy(&value, ptr, sizeof(T));
    return value;
}

template <typename T>
inline auto storeUnaligned(std::byte* ptr, T const& value) noexcept -> void {
    std::memcpy(ptr, &value, sizeof(T));
}

// A view over a single scalar at a possibly-unaligned address that transparently converts
// between the schema's declared byte order and native byte order on every read/write -
// like a single-element std::span, but byte-order-aware. Reads/writes go through
// loadUnaligned/storeUnaligned, so this is also safe regardless of alignment.
template <typename T>
class EndianValueRef {
public:
    constexpr explicit EndianValueRef(std::byte* ptr) noexcept : ptr_{ptr} {}

    [[nodiscard]] operator T() const noexcept {
        return swap(loadUnaligned<T>(ptr_));
    }

    auto operator=(T value) const noexcept -> EndianValueRef const& {
        storeUnaligned(ptr_, swap(value));
        return *this;
    }

private:
    [[nodiscard]] static auto swap([[maybe_unused]] T value) noexcept -> T {
{% if schema.byte_order == 'littleEndian' %}
        if constexpr (std::endian::native == std::endian::big) {
{% elif schema.byte_order == 'bigEndian' %}
        if constexpr (std::endian::native == std::endian::little) {
{% endif %}
            if constexpr (std::is_same_v<T, float>) {
                return std::bit_cast<float>(std::byteswap(std::bit_cast<std::uint32_t>(value)));
            } else if constexpr (std::is_same_v<T, double>) {
                return std::bit_cast<double>(std::byteswap(std::bit_cast<std::uint64_t>(value)));
            } else {
                return std::byteswap(value);
            }
        }
        return value;
    }

    std::byte* ptr_;
};

// A read-only, span-like view over a fixed-length array of scalars stored in the schema's
// byte order at a possibly-unaligned address. Nothing is converted up front: each element
// is loaded and byte-swapped only when it is actually accessed, so iterating a subset of a
// large array costs only what is read. Elements are returned by value (not by reference),
// since the stored representation may differ from the native one.
template <typename T, std::size_t N>
class EndianSpan {
public:
    using value_type = T;
    using size_type = std::size_t;

    class Iterator {
    public:
        using iterator_category = std::random_access_iterator_tag;
        using value_type = T;
        using difference_type = std::ptrdiff_t;

        constexpr Iterator() noexcept = default;

        constexpr Iterator(std::byte const* ptr, difference_type index) noexcept : ptr_{ptr}, index_{index} {}

        [[nodiscard]] auto operator*() const noexcept -> T {
            return EndianSpan::load(ptr_, static_cast<size_type>(index_));
        }

        [[nodiscard]] auto operator[](difference_type n) const noexcept -> T {
            return EndianSpan::load(ptr_, static_cast<size_type>(index_ + n));
        }

        constexpr auto operator++() noexcept -> Iterator& {
            ++index_; return *this;
        }

        constexpr auto operator++(int) noexcept -> Iterator {
            auto tmp = *this;
            ++index_;
            return tmp;
        }

        constexpr auto operator--() noexcept -> Iterator& {
            --index_;
            return *this;
        }

        constexpr auto operator--(int) noexcept -> Iterator {
            auto tmp = *this;
            --index_;
            return tmp;
        }

        constexpr auto operator+=(difference_type n) noexcept -> Iterator& {
            index_ += n;
            return *this;
        }

        constexpr auto operator-=(difference_type n) noexcept -> Iterator& {
            index_ -= n;
            return *this;
        }

        [[nodiscard]] friend constexpr auto operator+(Iterator it, difference_type n) noexcept -> Iterator {
            return it += n;
        }

        [[nodiscard]] friend constexpr auto operator+(difference_type n, Iterator it) noexcept -> Iterator {
            return it += n;
        }

        [[nodiscard]] friend constexpr auto operator-(Iterator it, difference_type n) noexcept -> Iterator {
            return it -= n;
        }

        [[nodiscard]] friend constexpr auto operator-(Iterator const& a, Iterator const& b) noexcept -> difference_type {
            return a.index_ - b.index_;
        }

        [[nodiscard]] friend constexpr auto operator==(Iterator const& a, Iterator const& b) noexcept -> bool {
            return a.index_ == b.index_;
        }

        [[nodiscard]] friend constexpr auto operator<=>(Iterator const& a, Iterator const& b) noexcept {
            return a.index_ <=> b.index_;
        }

    private:
        std::byte const* ptr_ = nullptr;
        difference_type index_ = 0;
    };

    constexpr explicit EndianSpan(std::byte const* ptr) noexcept : ptr_{ptr} {}

    [[nodiscard]] auto operator[](size_type index) const noexcept -> T {
        return load(ptr_, index);
    }

    [[nodiscard]] auto at(size_type index) const -> T {
        if (index >= N) [[unlikely]] {
            throw std::out_of_range{"EndianSpan index out of range"};
        }
        return load(ptr_, index);
    }

    [[nodiscard]] static constexpr auto size() noexcept -> size_type {
        return N;
    }

    [[nodiscard]] static constexpr auto empty() noexcept -> bool {
        return N == 0;
    }

    [[nodiscard]] auto front() const noexcept -> T {
        return load(ptr_, 0);
    }

    [[nodiscard]] auto back() const noexcept -> T {
        return load(ptr_, N - 1);
    }

    [[nodiscard]] constexpr auto begin() const noexcept -> Iterator {
        return Iterator{ptr_, 0};
    }

    [[nodiscard]] constexpr auto end() const noexcept -> Iterator {
        return Iterator{ptr_, static_cast<std::ptrdiff_t>(N)};
    }

private:
    [[nodiscard]] static auto load(std::byte const* ptr, size_type index) noexcept -> T {
        T value;
        std::memcpy(&value, ptr + index * sizeof(T), sizeof(T));
{% if schema.byte_order == 'littleEndian' %}
        if constexpr (std::endian::native == std::endian::big) {
{% elif schema.byte_order == 'bigEndian' %}
        if constexpr (std::endian::native == std::endian::little) {
{% endif %}
            if constexpr (std::is_same_v<T, float>) {
                return std::bit_cast<float>(std::byteswap(std::bit_cast<std::uint32_t>(value)));
            } else if constexpr (std::is_same_v<T, double>) {
                return std::bit_cast<double>(std::byteswap(std::bit_cast<std::uint64_t>(value)));
            } else {
                return std::byteswap(value);
            }
        }
        return value;
    }

    std::byte const* ptr_;
};

